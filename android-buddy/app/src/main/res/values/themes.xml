<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash (Android 12+ SplashScreen API, back-ported): brand background + the icon glyph, then a quick fade. -->
    <style name="Theme.Buddy.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Buddy</item>
    </style>

    <style name="Theme.Buddy" parent="@android:style/Theme.Material.NoActionBar" />

    <!-- Transparent and instant, for the activities that only exist to get focus or catch a share. -->
    <style name="Theme.Buddy.Clipboard" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
    </style>
</resources>
